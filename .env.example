# Copia questo file in ".env" e compila con le tue credenziali reali.
# NON committare mai ".env" con valori reali su Git.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Valhalla o GraphHopper self-hosted / free tier per il routing
ROUTING_API_URL=https://your-valhalla-instance.example.com

# Nominatim (geocoding) — usa l'istanza pubblica con rate-limit rispettato
# oppure self-hosted per volumi maggiori
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# Stile mappa MapLibre GL — OpenFreeMap (tile OSM gratuiti, nessuna API key)
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Radar Velox/Pattuglia — vedi supabase/migrations/0014_crew_reports.sql e
# lib/features/radar/ per l'architettura completa.
# Velox: Overpass API su OpenStreetMap (tag standard highway=speed_camera),
# nessuna API key richiesta. Vuoto = provider non configurato, lista
# vuota senza errori (stesso contratto di WAZE_GEORSS_URL sotto).
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Nessuna chiave richiesta: endpoint pubblico non ufficiale di Waze
# (live-map georss), filtrato lato client alla sola categoria POLICE.
WAZE_GEORSS_URL=https://www.waze.com/live-map/api/georss
